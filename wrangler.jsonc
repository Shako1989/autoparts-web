{
  // Cloudflare Workers Builds deploys this repo as a static-assets Worker:
  // `npm run build` writes dist/, then `wrangler deploy` (production branch)
  // or `wrangler versions upload` (other branches) publishes that directory.
  // "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "autoparts-web",
  "compatibility_date": "2026-11-04",
  "assets": {
    "directory": "./dist",
    // React Router owns the URL space: serve index.html for unknown paths
    // such as /v/ford/fusion/2019 or /p/<id> instead of a 404.
    "not_found_handling": "single-page-application"
  }
}
